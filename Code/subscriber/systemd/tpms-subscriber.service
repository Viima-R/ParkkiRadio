[Unit]
Description=TPMS Subscriber - MQTT to PostgreSQL
After=network.target mosquitto.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tpms_subscriber/venv/bin/python3 /opt/tpms_subscriber/tpms_subscriber.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tpms-subscriber

[Install]
WantedBy=multi-user.target
